{
  "compileOnSave": true,
  "compilerOptions": {
    "target": "es2015",
    "module": "node16",
    "moduleResolution": "node16",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "lib": ["es2015"],
    "noImplicitAny": false,
    "importHelpers": true,
    "sourceMap": true,
    "declaration": true
  }
}
