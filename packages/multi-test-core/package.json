{
  "name": "@multi-test/core",
  "version": "1.0.0",
  "description": "Collection of pure functions for calculating results of psychological tests",
  "author": "Yaroslav Serhieiev <noomorph@gmail.com>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/multi-test/multi-test/issues"
  },
  "homepage": "https://github.com/multi-test/multi-test#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:multi-test/multi-test.git",
    "directory": "packages/multi-test-core"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adaptivity": {
      "types": "./dist/adaptivity/adaptivity.d.ts",
      "require": "./dist/adaptivity/adaptivity.js",
      "default": "./dist/adaptivity/adaptivity.js"
    },
    "./alexithymia": {
      "types": "./dist/alexithymia/alexithymia.d.ts",
      "require": "./dist/alexithymia/alexithymia.js",
      "default": "./dist/alexithymia/alexithymia.js"
    },
    "./amon": {
      "types": "./dist/amon/amon.d.ts",
      "require": "./dist/amon/amon.js",
      "default": "./dist/amon/amon.js"
    },
    "./cattell": {
      "types": "./dist/cattell/cattell.d.ts",
      "require": "./dist/cattell/cattell.js",
      "default": "./dist/cattell/cattell.js"
    },
    "./emin": {
      "types": "./dist/emin/emin.d.ts",
      "require": "./dist/emin/emin.js",
      "default": "./dist/emin/emin.js"
    },
    "./factor5": {
      "types": "./dist/factor5/factor5.d.ts",
      "require": "./dist/factor5/factor5.js",
      "default": "./dist/factor5/factor5.js"
    },
    "./lsi": {
      "types": "./dist/lsi/lsi.d.ts",
      "require": "./dist/lsi/lsi.js",
      "default": "./dist/lsi/lsi.js"
    },
    "./maddi": {
      "types": "./dist/maddi/maddi.d.ts",
      "require": "./dist/maddi/maddi.js",
      "default": "./dist/maddi/maddi.js"
    },
    "./mendel": {
      "types": "./dist/mendel/mendel.d.ts",
      "require": "./dist/mendel/mendel.js",
      "default": "./dist/mendel/mendel.js"
    },
    "./mmpi": {
      "types": "./dist/mmpi/mmpi.d.ts",
      "require": "./dist/mmpi/mmpi.js",
      "default": "./dist/mmpi/mmpi.js"
    },
    "./rand36": {
      "types": "./dist/rand36/rand36.d.ts",
      "require": "./dist/rand36/rand36.js",
      "default": "./dist/rand36/rand36.js"
    },
    "./spa": {
      "types": "./dist/spa/spa.d.ts",
      "require": "./dist/spa/spa.js",
      "default": "./dist/spa/spa.js"
    },
    "./usk": {
      "types": "./dist/usk/usk.d.ts",
      "require": "./dist/usk/usk.js",
      "default": "./dist/usk/usk.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.spec.*",
    "!**/__*__"
  ],
  "scripts": {
    "prepare": ":",
    "build": "tsc",
    "lint": ":",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "@types/lodash": "^4.14.191",
    "jest": "^29.0.0",
    "lodash": "^4.17.21",
    "ts-jest": "^29.0.0",
    "tslib": "^2.5.0",
    "typescript": "^4.9.5"
  },
  "peerDependencies": {
    "tslib": "^2.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.spec.ts"
    ]
  }
}
